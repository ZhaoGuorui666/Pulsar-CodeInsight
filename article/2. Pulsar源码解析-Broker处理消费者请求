public class PulsarDecoder extends ByteToMessageDecoder {
    @Override
    protected void decode(ChannelHandlerContext ctx, 
            ByteBuf in, List<Object> out) {
        // 快速检查消息头
        if (in.readableBytes() < 4) {
            return;
        }
        
        // 使用索引而不是读取
        int frameSize = in.getInt(in.readerIndex());
        if (in.readableBytes() < frameSize + 4) {
            return;
        }
        
        // 一次性读取完整消息
        ByteBuf frame = in.retainedSlice(
            in.readerIndex() + 4, 
            frameSize
        );
        in.skipBytes(frameSize + 4);
        out.add(frame);
    }
}
