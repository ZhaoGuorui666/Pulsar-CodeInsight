        handleMaxRetriesExceeded(entries);
        return;
    }
    
    // 计算重试延迟
    long delay = retryPolicy.getNextRetryDelay(retryCount);
    
    // 调度重试
    executor.schedule(() -> {
        // 重新发送消息
        sendMessages(entries)
            .exceptionally(cause -> {
                // 发送失败继续重试
                retryMessageSend(entries, retryCount + 1);
                return null;
            });
    }, delay, TimeUnit.MILLISECONDS);
}
