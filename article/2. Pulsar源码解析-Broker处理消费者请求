public class RetryPolicy {
    // 最大重试次数
    private final int maxRetries;
    // 初始重试延迟
    private final long initialDelayMs;
    // 最大重试延迟
    private final long maxDelayMs;
    
    public long getNextRetryDelay(int retryCount) {
        // 指数退避算法
        long delay = Math.min(
            initialDelayMs * Math.pow(2, retryCount),
            maxDelayMs
        );
        return delay;
    }
}
```

